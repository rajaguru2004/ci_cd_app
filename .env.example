# ─── Console access ──────────────────────────────────────────────────────────
# Shared password for the console's sign-in page.
CONSOLE_PASSWORD=
# Signs the session cookie; at least 32 characters: openssl rand -hex 32
SESSION_SECRET=
# true when the console is served over https (behind a TLS proxy).
COOKIE_SECURE=false

# ─── GitHub (the mobile app repository) ──────────────────────────────────────
# Fine-grained personal access token, repository access: only the mobile repo.
# Permissions: Actions read/write, Contents read, Secrets read/write,
# Variables read (Metadata read is added automatically).
GITHUB_TOKEN=
GITHUB_REPO=the-reciprocal-solutions/human-resource-management-mobile-ess
WORKFLOW_FILE=release.yml

# ─── Google Play ─────────────────────────────────────────────────────────────
ANDROID_PACKAGE_NAME=com.fusionapps.fusionhrm
# The service-account key is a file, not a variable: docker-compose mounts
# ${PLAY_KEY_FILE:-./secrets/play-service-account.json} read-only.
# PLAY_KEY_FILE=./secrets/play-service-account.json

# ─── Builds on this server (uploaded source ZIPs) ────────────────────────────
# The builder container runs the same pipeline for a source ZIP uploaded in the
# console (GitHub → Code → Download ZIP). Works without GITHUB_TOKEN.
# Shared secret between the api and the builder; at least 32 characters:
#   openssl rand -hex 32
BUILDER_TOKEN=
# Largest ZIP the console accepts, in MB.
MAX_UPLOAD_MB=500
# Resources for one build (the builder runs one at a time; others queue).
BUILDER_CPUS=6
BUILDER_MEMORY=8g
# Gradle's heap inside that memory (the app's own gradle.properties asks for more).
BUILDER_GRADLE_HEAP=4g
# Finished runs kept on disk (logs, AAB); older ones are removed.
BUILDER_KEEP_RUNS=30

# ─── Serving ─────────────────────────────────────────────────────────────────
CONSOLE_PORT=7080
# 127.0.0.1 keeps the console reachable only through a reverse proxy on the host.
CONSOLE_BIND=0.0.0.0

# ─── Images (deploy.sh push / server) ────────────────────────────────────────
IMAGE_PREFIX=rajaguru2004/fusionhrm-mobile-ci
IMAGE_TAG=latest
