# ─── Console access ──────────────────────────────────────────────────────────
# Shared password for the console's sign-in page.
CONSOLE_PASSWORD=
# Signs the session cookie; at least 32 characters: openssl rand -hex 32
SESSION_SECRET=
# true when the console is served over https (behind a TLS proxy).
COOKIE_SECURE=false

# ─── The builder (vault, git, pipeline) ──────────────────────────────────────
# Shared secret between the api and the builder; at least 32 characters:
#   openssl rand -hex 32
BUILDER_TOKEN=
# Encrypts the vault: every SSH key, upload keystore (and its passwords) and app
# Play key the console stores. At least 32 characters: openssl rand -hex 32
# Keep a copy somewhere safe: without it the stored keys cannot be opened, and
# changing it makes them unreadable (the builder refuses to start).
VAULT_KEY=
# Largest source ZIP accepted, in MB.
MAX_UPLOAD_MB=500
# Resources for one build (the builder runs one at a time; others queue).
BUILDER_CPUS=6
BUILDER_MEMORY=8g
# Gradle's heap inside that memory (a project's own gradle.properties may ask for more).
BUILDER_GRADLE_HEAP=4g
# Finished runs kept on disk per app (logs, AAB); older ones are removed.
BUILDER_KEEP_RUNS=30
# GitHub's REST API, for apps that build on their own GitHub Actions (Settings →
# Where builds run). A GitHub token is pasted there (or once, as the console's
# default, on the Setup page) — not here. Only set this for GitHub Enterprise Server.
# GITHUB_API_URL=https://api.github.com

# ─── iOS on Mac runners ──────────────────────────────────────────────────────
# Macs connect to this console's own address (CONSOLE_PORT below) with a token made on the
# Runners page; nothing else is needed here. The image the Runners page tells a Mac to run:
# MAC_RUNNER_IMAGE=rajaguru2004/release-console-mac-runner:latest

# ─── Google Play (optional default key) ──────────────────────────────────────
# Apps upload their own service-account key in their settings. A key placed at
# ${SECRETS_DIR:-./secrets}/play-service-account.json is the default for apps
# without one (mounted read-only into the builder only).
# SECRETS_DIR=./secrets

# ─── Serving ─────────────────────────────────────────────────────────────────
CONSOLE_PORT=7080
# 127.0.0.1 keeps the console reachable only through a reverse proxy on the host.
CONSOLE_BIND=0.0.0.0

# ─── Images (deploy.sh push / server) ────────────────────────────────────────
IMAGE_PREFIX=rajaguru2004/release-console
IMAGE_TAG=latest
