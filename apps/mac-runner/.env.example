# ─── The console ─────────────────────────────────────────────────────────────
# The console as this Mac reaches it: its address on your network, or https://… behind a proxy.
SERVER_URL=http://192.168.0.189:7080
# The token the console showed when this Mac was added (Runners → Add a Mac). Keep it secret:
# it lets a machine take this console's iOS runs.
RUNNER_TOKEN=

# ─── This Mac ────────────────────────────────────────────────────────────────
# The macOS account builds run as (whoami): its Xcode, its Flutter, its keychain. Remote Login
# must be on for it (System Settings → General → Sharing → Remote Login).
MAC_USER=
# Where the container reaches the Mac's SSH (Docker Desktop and OrbStack: host.docker.internal).
# MAC_HOST=host.docker.internal
# MAC_PORT=22
# The runner's folder on the Mac: each run's checkout and outputs, and the Fastlane gem cache.
# MAC_WORK_DIR=~/release-console-runner/work
# Folders put first on PATH for builds, when the login shell (~/.zprofile) does not set them,
# e.g. Flutter's bin folder: MAC_PATH_PREFIX=/Users/you/development/flutter/bin
# MAC_PATH_PREFIX=
# 1 keeps a run's folder on the Mac after it ends (to look into a failure).
# KEEP_WORK=0

# ─── The image ───────────────────────────────────────────────────────────────
# RUNNER_IMAGE=rajaguru2004/release-console-mac-runner:latest
