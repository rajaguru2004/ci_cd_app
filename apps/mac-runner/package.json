{
  "name": "release-console-mac-runner",
  "version": "1.0.0",
  "private": true,
  "description": "The Release Console's Mac runner: dials out to the console, takes iOS runs, and builds and releases them on its Mac (over SSH from a container, or in place).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js start",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.0",
    "@types/ssh2": "^1.15.6",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.ts$": "ts-jest" },
    "testEnvironment": "node"
  }
}
