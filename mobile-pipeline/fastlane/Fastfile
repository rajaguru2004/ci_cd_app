# Google Play release automation for the FusionHRM Android app.
#
# GitHub Actions (.github/workflows/release.yml) tests the code and builds the signed AAB;
# these lanes only talk to Google Play:
#
#   fastlane android deploy       upload the CI-built AAB to a Play track
#   fastlane android play_status  check the service-account key and read each track's codes
#
# Both read the service-account key from PLAY_SERVICE_ACCOUNT_JSON (a GitHub Actions secret)
# and write a small JSON report next to this file, which CI uploads as an artifact for the
# pipeline console to read.
#
# PLAY_VALIDATE_ONLY=true makes `deploy` a dress rehearsal: the bundle is uploaded into an edit
# and Google validates the whole release (signature, version code, track, notes), but the edit
# is never committed, so nothing is published and no version code is spent.
require 'json'
require 'time'

opt_out_usage
default_platform(:android)

PACKAGE_NAME = 'com.fusionapps.fusionhrm'
TRACKS = %w[internal alpha beta production].freeze
RELEASE_STATUSES = %w[completed draft].freeze
# Repository root: GitHub sets GITHUB_WORKSPACE; locally, the folder above fastlane/.
ROOT = ENV.fetch('GITHUB_WORKSPACE') { File.expand_path('..', __dir__) }

platform :android do
  desc 'Upload the AAB built by CI to a Google Play track'
  lane :deploy do
    key = play_key!
    track = required_env('PLAY_TRACK')
    UI.user_error!("PLAY_TRACK '#{track}' is not one of: #{TRACKS.join(', ')}.") unless TRACKS.include?(track)
    status = ENV.fetch('PLAY_RELEASE_STATUS', 'completed')
    unless RELEASE_STATUSES.include?(status)
      UI.user_error!("PLAY_RELEASE_STATUS '#{status}' is not one of: #{RELEASE_STATUSES.join(', ')}.")
    end
    version_code = Integer(required_env('VERSION_CODE'))
    aab = File.expand_path(required_env('AAB_PATH'), ROOT)
    UI.user_error!("No AAB at #{aab}.") unless File.exist?(aab)

    # Play refuses a version code it has seen, but only after the whole bundle is uploaded
    # and with a message that does not say what to change. Refuse first, and say it.
    highest = track_version_codes(key).values.flatten.max
    if highest && version_code <= highest
      UI.user_error!(
        "Google Play already has versionCode #{highest}; this build is #{version_code}. " \
        'Raise the repository variable VERSION_CODE_OFFSET so the next run numbers land above it, then run again.'
      )
    end

    upload = {
      package_name: PACKAGE_NAME,
      json_key_data: key,
      track: track,
      release_status: status,
      aab: aab,
      # Only the "What's new" text goes up; the store listing is managed in Play Console.
      metadata_path: File.join(ROOT, 'fastlane', 'metadata', 'android'),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false
    }
    # The R8 mapping lets Play Console de-obfuscate crash stack traces for this version.
    mapping = ENV['MAPPING_PATH'].to_s.empty? ? nil : File.expand_path(ENV['MAPPING_PATH'], ROOT)
    upload[:mapping] = mapping if mapping && File.exist?(mapping)
    validate_only = ENV['PLAY_VALIDATE_ONLY'] == 'true'
    upload[:validate_only] = true if validate_only
    upload_to_play_store(upload)

    write_report('release-info.json', {
      packageName: PACKAGE_NAME,
      track: track,
      releaseStatus: status,
      versionName: ENV['VERSION_NAME'],
      versionCode: version_code,
      previousHighestVersionCode: highest,
      validatedOnly: validate_only,
      uploadedAt: Time.now.utc.iso8601,
      storeUrl: "https://play.google.com/store/apps/details?id=#{PACKAGE_NAME}"
    })
    if validate_only
      UI.success("Google Play validated versionCode #{version_code} for the #{track} track; nothing was published.")
    else
      UI.success("versionCode #{version_code} is on the #{track} track (#{status}).")
    end
  end

  desc "Check the Play service-account key and read every track's version codes"
  lane :play_status do
    key = play_key!
    validate_play_store_json_key(json_key_data: key)
    tracks = track_version_codes(key)
    highest = tracks.values.flatten.max
    next_code = ENV['VERSION_CODE'].to_s.empty? ? nil : Integer(ENV['VERSION_CODE'])
    if highest && next_code && next_code <= highest
      UI.important("This run's version code #{next_code} is not above Play's #{highest}: raise VERSION_CODE_OFFSET before releasing.")
    end
    write_report('play-status.json', {
      packageName: PACKAGE_NAME,
      checkedAt: Time.now.utc.iso8601,
      tracks: tracks,
      highestVersionCode: highest,
      runVersionCode: next_code
    })
    UI.success("Google Play key works for #{PACKAGE_NAME}; highest versionCode: #{highest || 'none'}.")
  end
end

def play_key!
  key = ENV['PLAY_SERVICE_ACCOUNT_JSON'].to_s
  if key.strip.empty?
    UI.user_error!(
      'The PLAY_SERVICE_ACCOUNT_JSON secret is missing. Upload the Google Play service-account key on the ' \
      "console's Setup page, or add it under GitHub > Settings > Secrets and variables > Actions."
    )
  end
  key
end

def required_env(name)
  value = ENV[name].to_s
  UI.user_error!("#{name} is not set.") if value.empty?
  value
end

# Version codes per track. A track that has never had a release answers with an error on
# some accounts; it counts as empty rather than failing the lane.
def track_version_codes(key)
  TRACKS.to_h do |track|
    codes = begin
      google_play_track_version_codes(package_name: PACKAGE_NAME, track: track, json_key_data: key)
    rescue StandardError => e
      UI.important("#{track}: #{e.message}")
      []
    end
    [track, Array(codes).map(&:to_i).sort]
  end
end

def write_report(name, data)
  path = File.join(ROOT, 'fastlane', name)
  File.write(path, JSON.pretty_generate(data))
  UI.message("Wrote #{path}")
end
